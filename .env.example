# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=sk

# Embedding Model (for semantic search)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Generation Model (for answering questions)
# Choose from available models via OpenRouter:
# FREE/OPEN-SOURCE MODELS:
#   - meta-llama/llama-2-70b-chat
#   - meta-llama/llama-3-70b-instruct
#   - mistralai/mistral-7b-instruct
#   - nousresearch/nous-hermes-2-mixtral-8x7b-dpo
#
# PAID MODELS (with API key):
#   OpenAI: openai/gpt-4-turbo, openai/gpt-3.5-turbo
#   Claude: anthropic/claude-3-opus, anthropic/claude-3-sonnet
#   Google: google/gemini-2.5-flash, google/gemini-pro
#   Other: mistralai/mistral-large, cohere/command-r-plus
#
# View all models at: https://openrouter.ai/api/v1/models
GENERATION_MODEL=google/gemini-2.5-flash
